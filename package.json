{
  "name": "hyunahah",
  "version": "1.0.0",
  "description": "노인일자리 교육 이수 확인 — Supabase 서버 저장",
  "main": "server.mjs",
  "scripts": {
    "build": "tailwindcss -i ./styles.input.css -o ./styles.css --minify",
