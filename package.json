  "type": "module",
  "bugs": {
    "url": "https://github.com/junghyunah/hyunahah/issues"
  },
  "homepage": "https://github.com/junghyunah/hyunahah#readme",
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "@supabase/supabase-js": "2.99.2",
    "jszip": "3.10.1",
    "lucide": "0.468.0",
    "pdf-lib": "1.17.1",
    "pngjs": "7.0.0",
    "serverless-http": "3.2.0",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
